{
  "name": "videocut.chat - cloud captioned MP4",
  "nodes": [
    {
      "id": "video-input",
      "name": "Video Input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "start-render",
      "name": "Start Render",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://mcp.zjtemplate.com/v1/tools/saycut_render_video",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { asset_id: $json.asset_id, ...( $json.captions ? { captions: $json.captions } : {} ), style_id: $json.style_id || 'runtime/ZapMotion', allow_cloud_processing: $json.allow_cloud_processing === true, idempotency_key: 'n8n-' + $execution.id + '-' + $json.asset_id } }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "wait",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        700,
        0
      ],
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      }
    },
    {
      "id": "check-job",
      "name": "Check Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://mcp.zjtemplate.com/v1/tools/saycut_get_job",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { job_id: $('Start Render').item.json.job_id } }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "finished-or-timed-out",
      "name": "Finished Or Timed Out",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1180,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Finished Or Timed Out",
              "leftValue": "={{ !['queued','running'].includes($json.status) || Date.now() / 1000 - $json.created > 7200 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "succeeded",
      "name": "Succeeded",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1420,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Succeeded",
              "leftValue": "={{ $json.status === 'succeeded' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "render-failed",
      "name": "Render Failed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1660,
        180
      ],
      "parameters": {
        "errorMessage": "={{ JSON.stringify($json.error || { code: 'workflow_timeout', job_id: $json.job_id }) }}"
      }
    },
    {
      "id": "video-ready",
      "name": "Video Ready",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1660,
        -100
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Video Input": {
      "main": [
        [
          {
            "node": "Start Render",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start Render": {
      "main": [
        [
          {
            "node": "Wait",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait": {
      "main": [
        [
          {
            "node": "Check Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Job": {
      "main": [
        [
          {
            "node": "Finished Or Timed Out",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Finished Or Timed Out": {
      "main": [
        [
          {
            "node": "Succeeded",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Succeeded": {
      "main": [
        [
          {
            "node": "Video Ready",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Render Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
